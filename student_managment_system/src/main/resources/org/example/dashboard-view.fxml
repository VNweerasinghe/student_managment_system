<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-root" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.DashboardController">
    <left>
        <VBox prefWidth="218.0" spacing="22.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="18.0" right="18.0" top="26.0" />
            </padding>
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="brand-title" text="CAMPUS / DESK" />
                        <Label styleClass="brand-caption" text="STUDENT RECORDS" />
                    </children>
                </VBox>
                <Label styleClass="sidebar-section" text="WORKSPACE" />
                <Button maxWidth="Infinity" styleClass="nav-selected" text="  Student directory" />
                <VBox VBox.vgrow="ALWAYS" />
                <VBox spacing="4.0" styleClass="sidebar-note">
                    <children>
                        <Label styleClass="sidebar-note-title" text="LOCAL DATABASE" />
                        <Label styleClass="sidebar-note-copy" text="Records are saved on this computer." wrapText="true" />
                    </children>
                </VBox>
                <Button maxWidth="Infinity" onAction="#logout" styleClass="logout-button" text="Sign out" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="22.0" styleClass="main-content">
            <padding>
                <Insets bottom="26.0" left="30.0" right="30.0" top="26.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="eyebrow" text="OVERVIEW" />
                                <Label styleClass="page-title" text="Student directory" />
                                <Label fx:id="welcomeLabel" styleClass="page-subtitle" text="Welcome back" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" />
                        <Button onAction="#refresh" styleClass="secondary-button" text="Refresh" />
                    </children>
                </HBox>
                <HBox spacing="14.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" spacing="9.0" styleClass="stat-panel">
                            <children>
                                <Label styleClass="stat-label" text="TOTAL STUDENTS" />
                                <Label fx:id="totalCountLabel" styleClass="stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="9.0" styleClass="stat-panel">
                            <children>
                                <Label styleClass="stat-label" text="CURRENTLY ENROLLED" />
                                <Label fx:id="enrolledCountLabel" styleClass="stat-value green-number" text="0" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="9.0" styleClass="stat-panel">
                            <children>
                                <Label styleClass="stat-label" text="GRADUATED" />
                                <Label fx:id="graduatedCountLabel" styleClass="stat-value orange-number" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <TextField fx:id="searchField" HBox.hgrow="ALWAYS" maxWidth="420.0" promptText="Search name, ID, email, course or status" styleClass="search-field" />
                        <VBox HBox.hgrow="ALWAYS" />
                        <Button onAction="#exportCsv" styleClass="secondary-button" text="Export CSV" />
                        <Button onAction="#editStudent" styleClass="secondary-button" text="Edit" />
                        <Button onAction="#deleteStudent" styleClass="danger-button" text="Delete" />
                        <Button onAction="#addStudent" styleClass="primary-button" text="+  Add student" />
                    </children>
                </HBox>
                <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS" styleClass="student-table">
                    <placeholder>
                        <Label styleClass="empty-state" text="No students match this search. Add a student or change your search." wrapText="true" />
                    </placeholder>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label fx:id="statusLabel" styleClass="status-text" text="Student data is stored locally." />
                        <VBox HBox.hgrow="ALWAYS" />
                        <Label styleClass="footer-note" text="Student Management System" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>