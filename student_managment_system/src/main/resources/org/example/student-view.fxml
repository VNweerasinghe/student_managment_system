<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="520.0" spacing="18.0" styleClass="app-root" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/26.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.LogInPageController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <Label styleClass="page-title" text="Student Management System" />
        <VBox alignment="CENTER" maxWidth="360.0" spacing="12.0" styleClass="main-content">
            <padding>
                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="eyebrow" text="SIGN IN" />
                <TextField fx:id="usernameField" promptText="Username" />
                <PasswordField fx:id="passwordField" promptText="Password" />
                <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Login" />
                <Label fx:id="statusLabel" styleClass="status-text" text="" wrapText="true" />
            </children>
        </VBox>
    </children>
</VBox>
